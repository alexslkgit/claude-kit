<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alexslk.tasks-board-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>PYTHON_BIN</string>
        <string>HOME_DIR/.claude/tools/tasks-server.py</string>
        <string>8899</string>
        <string>TASKS_DIR</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>TASKS_DIR/_shell/board-server.log</string>
    <key>StandardErrorPath</key>
    <string>TASKS_DIR/_shell/board-server.log</string>
</dict>
</plist>
